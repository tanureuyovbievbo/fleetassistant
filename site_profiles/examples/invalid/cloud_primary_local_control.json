{
  "schema_version": 1,
  "site": { "id": "invalid_cloud_local", "name": "Cloud site with local control" },
  "deployment": { "profile": "cloud_primary" },
  "consent": { "granted": true },
  "systems": [
    {
      "id": "main",
      "name": "Main",
      "haeo": { "hub": "invalid_cloud_local_main", "horizon": { "mode": "preset", "preset_days": 5 } },
      "elements": [
        { "id": "grid", "kind": "grid", "import_limit_kw": 10, "export_limit_kw": 5 },
        { "id": "house", "kind": "load", "forecast_entity": "sensor.load" }
      ],
      "connections": [{ "from": "grid", "to": "house" }]
    }
  ],
  "controls": [
    {
      "id": "export_limit",
      "element": "grid",
      "capability": "set_export_limit",
      "unit": "kW",
      "min": 0,
      "max": 5,
      "rate_limit_per_minute": 6,
      "hysteresis": 0.1,
      "consent_required": true,
      "backing": "local",
      "authority": "full",
      "fail_safe_value": 5
    }
  ],
  "pricing": { "provider": { "type": "flat", "currency_per_kwh": 0.3 } },
  "rule_packs": []
}
